{
  "version": "1.0.0",
  "date": "2026-11-22",
  "identity": {
    "field": "username",
    "pattern": "^[a-z0-9._-]{3,64}$",
    "example": "ana.perez",
    "email_supported": false,
    "stable_key": "id",
    "area_pattern": "^[A-Za-z0-9_-]+$",
    "roles": [
      "empleado",
      "supervisor",
      "ti"
    ]
  },
  "session": {
    "algorithm": "RS256",
    "issuer": "uide-auth",
    "audience": "uide-chat",
    "ttl_seconds": 900,
    "claims": [
      "sub",
      "jti",
      "iat",
      "exp",
      "iss",
      "aud"
    ],
    "revalidate_seconds": 30,
    "close_within_seconds": 60
  },
  "login": {
    "method": "POST",
    "path": "/login",
    "request": [
      "username",
      "password"
    ],
    "response": [
      "access_token",
      "token_type",
      "expires_in"
    ]
  },
  "profile_fields": [
    "id",
    "username",
    "role",
    "area",
    "active"
  ],
  "validation": {
    "method": "POST",
    "path": "/sessions/validate",
    "body": null,
    "headers": [
      "Authorization",
      "X-Service-Key"
    ]
  },
  "routes": {
    "/health": [
      "GET"
    ],
    "/login": [
      "POST"
    ],
    "/me": [
      "GET"
    ],
    "/logout": [
      "POST"
    ],
    "/users": [
      "GET",
      "POST"
    ],
    "/users/{uid}": [
      "PATCH"
    ],
    "/audit": [
      "GET"
    ],
    "/public-key": [
      "GET"
    ],
    "/sessions/validate": [
      "POST"
    ]
  },
  "ports": {
    "auth_https": 8000,
    "chat_wss_planned": 443,
    "postgresql_tls_planned": 5432
  },
  "limits": {
    "password_min": 12,
    "password_max": 128,
    "login_failures": 5,
    "login_window_seconds": 300,
    "login_lock_seconds": 300,
    "login_requests_per_ip_per_minute": 30,
    "chat_connections_planned": 5,
    "chat_messages_per_minute_planned": 30,
    "message_max_characters_planned": 2000,
    "message_max_utf8_bytes_planned": 4096
  },
  "ownership": {
    "auth_service": "Arthur",
    "security_go": "Arthur",
    "chat_and_client": "Luis y Arthur",
    "network_and_persistence": "Alex"
  },
  "implementation": {
    "auth": "laboratorio probado",
    "chat": "diseño pendiente de implementación integrada",
    "network": "prototipo semana 9; VLAN/ACL/firewall pendientes"
  }
}
