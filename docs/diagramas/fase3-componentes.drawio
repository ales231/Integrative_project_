        <mxCell id="ui" value="&lt;b&gt;Cliente / consola — diseño&lt;/b&gt;&lt;br/&gt;Interfaz, login y fachada de cuentas TI. Envía contraseñas solo a FastAPI." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="85" width="215" height="90" />
        </mxCell>
        <mxCell id="chat" value="&lt;b&gt;Servidor de chat — diseño&lt;/b&gt;&lt;br/&gt;Protocolo, manejadores, autorización por recurso, límites y métricas." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="85" width="215" height="90" />
