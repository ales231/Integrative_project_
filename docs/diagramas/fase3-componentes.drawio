        <mxCell id="auth" value="&lt;b&gt;auth-service — implementado&lt;/b&gt;&lt;br/&gt;Usuarios, roles, áreas, hashes, sesiones y auditoría de API." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="235" width="215" height="90" />
