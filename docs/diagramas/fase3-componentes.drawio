        <mxCell id="adapter" value="&lt;b&gt;security-go — implementado&lt;/b&gt;&lt;br/&gt;New(HTTPS, publicPEM, caPEM, key). Validate(ctx, token) → User, error." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="235" width="215" height="90" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Persistencia — diseño&lt;/b&gt;&lt;br/&gt;Chat: salas, mensajes, perfiles vinculados al ID. Auth: tablas security_* con cuenta distinta." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
