<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Clases e interfaces de integración">
    <mxGraphModel page="1" pageWidth="595" pageHeight="842">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="client" value="&lt;b&gt;ClienteChat — diseño&lt;/b&gt;&lt;br/&gt;IniciarSesion(username, password)&lt;br/&gt;AdministrarCuentaPorID(uid)&lt;br/&gt;CerrarSesion() → POST /logout&lt;br/&gt;Token solo en memoria" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="85" width="230" height="105" />
        </mxCell>
        <mxCell id="chat" value="&lt;b&gt;ServidorChat — diseño&lt;/b&gt;&lt;br/&gt;Validar antes de cada operación&lt;br/&gt;Comprobar rol/área/membresía&lt;br/&gt;Revisar ociosas cada 30 s&lt;br/&gt;Cerrar revocadas antes de 60 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="310" y="85" width="225" height="105" />
        </mxCell>
        <mxCell id="sec" value="&lt;b&gt;security.Client — existente&lt;/b&gt;&lt;br/&gt;New(url, publicPEM, caPEM, key)&lt;br/&gt;Validate(ctx, token) (User, error)&lt;br/&gt;User: Active, ID, Username,&lt;br/&gt;Role, Area" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="255" width="230" height="110" />
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;RepositorioChat — diseño&lt;/b&gt;&lt;br/&gt;Perfil por ID de FastAPI&lt;br/&gt;Sala: área y miembros&lt;br/&gt;Mensaje: autorID y texto&lt;br/&gt;No escribir roles ni hashes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="310" y="255" width="225" height="110" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI — autoridad existente&lt;/b&gt;&lt;br/&gt;Cuenta: id, username, role, area, active&lt;br/&gt;JWT: sub, jti, iat, exp, iss, aud" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="160" y="430" width="275" height="75" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="client" target="api" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="chat" target="sec" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="chat" target="repo" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="sec" target="api" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>