<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Secuencia vigente de identidad y sesión">
    <mxGraphModel page="1" pageWidth="595" pageHeight="842">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="login" value="&lt;b&gt;1. Cliente → FastAPI HTTPS&lt;/b&gt;&lt;br/&gt;POST /login {username, password}" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="80" width="375" height="55" />
        </mxCell>
        <mxCell id="token" value="&lt;b&gt;2. FastAPI → Cliente&lt;/b&gt;&lt;br/&gt;access_token, token_type=bearer, expires_in=900" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="165" width="375" height="55" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;3. Chat → security-go → FastAPI&lt;/b&gt;&lt;br/&gt;Firma local + POST /sessions/validate; Bearer y X-Service-Key. Perfil vigente." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="250" width="375" height="65" />
        </mxCell>
        <mxCell id="authz" value="&lt;b&gt;4. Chat autoriza la operación&lt;/b&gt;&lt;br/&gt;Rol, área y membresía; límites por cuenta y por mensaje." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="345" width="375" height="55" />
        </mxCell>
        <mxCell id="repeat" value="&lt;b&gt;5. Nueva operación / intervalo de 30 s&lt;/b&gt;&lt;br/&gt;Repetir Validate incluso sin tráfico. Error: denegar y cerrar; revocada antes de 60 s." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="430" width="375" height="65" />
        </mxCell>
        <mxCell id="logout" value="&lt;b&gt;6. Cliente → FastAPI&lt;/b&gt;&lt;br/&gt;POST /logout; cerrar WSS y borrar token. Reuso: 401." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="525" width="375" height="55" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="login" target="token" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="token" target="validate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="validate" target="authz" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="authz" target="repeat" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="repeat" target="logout" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>